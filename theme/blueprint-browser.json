{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Autodocs Publish Theme Playground",
		"author": "Automattic",
		"description": "A browser-ready Autodocs Publish block-theme site with editable templates, style variations, documentation, posts, threaded comments, and Site Editor components."
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"constants": {
		"JETPACK_DEV_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "development"
	},
	"landingPage": "/wp-admin/site-editor.php",
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/Automattic/autodocs-publish",
				"ref": "main",
				"refType": "branch",
				"path": "plugins/autodocs-publish-blocks"
			},
			"options": {
				"activate": true,
				"targetFolderName": "autodocs-publish-blocks"
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/Automattic/autodocs-publish",
				"ref": "main",
				"refType": "branch",
				"path": "theme"
			},
			"options": {
				"activate": true,
				"targetFolderName": "autodocs-publish"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "jetpack"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require get_theme_root( 'autodocs-publish' ) . '/autodocs-publish/playground/setup.php';"
		}
	]
}
