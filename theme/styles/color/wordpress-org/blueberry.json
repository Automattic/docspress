{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "WordPress.org · Blueberry",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "accent", "color": "#3858e9", "name": "Blueberry" },
				{ "slug": "accent-strong", "color": "#213fd4", "name": "Deep blueberry" },
				{ "slug": "accent-soft", "color": "#eff2ff", "name": "Blueberry wash" },
				{ "slug": "highlight", "color": "#fff972", "name": "Lemon" },
				{ "slug": "highlight-strong", "color": "#1e1e1e", "name": "Highlight strong" },
				{ "slug": "paper", "color": "#ffffff", "name": "White" },
				{ "slug": "header-surface", "color": "color-mix(in srgb, var(--dp-paper) 92%, transparent)", "name": "Header surface" },
				{ "slug": "canvas", "color": "#f6f6f6", "name": "Light grey" },
				{ "slug": "ink", "color": "#1e1e1e", "name": "Charcoal" },
				{ "slug": "copy", "color": "#40464d", "name": "Charcoal 3" },
				{ "slug": "muted", "color": "#656a71", "name": "Charcoal 4" },
				{ "slug": "line", "color": "#d9d9d9", "name": "Light grey 1" },
				{ "slug": "line-strong", "color": "#979aa1", "name": "Charcoal 5" },
				{ "slug": "code", "color": "#1e1e1e", "name": "Code charcoal" },
				{ "slug": "dark-accent", "color": "#9fb1ff", "name": "Dark accent" },
				{ "slug": "dark-accent-strong", "color": "#c7d1ff", "name": "Dark accent strong" },
				{ "slug": "dark-accent-soft", "color": "#29336b", "name": "Dark accent soft" },
				{ "slug": "dark-paper", "color": "#1e1e1e", "name": "Dark paper" },
				{ "slug": "dark-canvas", "color": "#1a1919", "name": "Dark canvas" },
				{ "slug": "dark-ink", "color": "#ffffff", "name": "Dark ink" },
				{ "slug": "dark-copy", "color": "#d9d9d9", "name": "Dark copy" },
				{ "slug": "dark-muted", "color": "#979aa1", "name": "Dark muted" },
				{ "slug": "dark-line", "color": "#40464d", "name": "Dark line" },
				{ "slug": "dark-line-strong", "color": "#656a71", "name": "Dark line strong" },
				{ "slug": "dark-code", "color": "#111111", "name": "Dark code" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|copy"
		},
		"elements": {
			"button": {
				"color": { "background": "var:preset|color|accent", "text": "var:preset|color|paper" },
				":hover": { "color": { "background": "var:preset|color|accent-strong", "text": "var:preset|color|paper" } },
				":focus-visible": { "outline": { "color": "var:preset|color|accent" } }
			},
			"caption": { "color": { "background": "transparent", "text": "var:preset|color|muted" } },
			"heading": { "color": { "background": "transparent", "text": "var:preset|color|ink" } },
			"h1": { "color": { "background": null, "text": null } },
			"h2": { "color": { "background": null, "text": null } },
			"h3": { "color": { "background": null, "text": null } },
			"h4": { "color": { "background": null, "text": null } },
			"h5": { "color": { "background": null, "text": null } },
			"h6": { "color": { "background": null, "text": null } },
			"link": {
				"color": { "background": "transparent", "text": "var:preset|color|accent-strong" },
				":hover": { "color": { "text": "var:preset|color|accent" } }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": { "color": "var:preset|color|accent" },
						"color": { "background": "transparent", "text": "var:preset|color|accent-strong" }
					}
				}
			},
			"core/code": {
				"color": { "background": "var:preset|color|code", "text": "var:preset|color|dark-ink" }
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|accent" } }
			}
		}
	}
}
