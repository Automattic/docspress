{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "WordPress.org",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "accent", "color": "#3858e9", "name": "Blueberry" },
				{ "slug": "accent-strong", "color": "#213fd4", "name": "Deep blueberry" },
				{ "slug": "accent-soft", "color": "#eff2ff", "name": "Blueberry wash" },
				{ "slug": "highlight", "color": "#fff972", "name": "Lemon" },
				{ "slug": "highlight-strong", "color": "#1e1e1e", "name": "Highlight strong" },
				{ "slug": "paper", "color": "#ffffff", "name": "White" },
				{ "slug": "header-surface", "color": "color-mix(in srgb, var(--dp-paper) 92%, transparent)", "name": "Header surface" },
				{ "slug": "canvas", "color": "#f6f6f6", "name": "Light grey" },
				{ "slug": "ink", "color": "#1e1e1e", "name": "Charcoal" },
				{ "slug": "copy", "color": "#40464d", "name": "Charcoal 3" },
				{ "slug": "muted", "color": "#656a71", "name": "Charcoal 4" },
				{ "slug": "line", "color": "#d9d9d9", "name": "Light grey 1" },
				{ "slug": "line-strong", "color": "#979aa1", "name": "Charcoal 5" },
				{ "slug": "code", "color": "#1e1e1e", "name": "Code charcoal" },
				{ "slug": "dark-accent", "color": "#9fb1ff", "name": "Dark accent" },
				{ "slug": "dark-accent-strong", "color": "#c7d1ff", "name": "Dark accent strong" },
				{ "slug": "dark-accent-soft", "color": "#29336b", "name": "Dark accent soft" },
				{ "slug": "dark-paper", "color": "#1e1e1e", "name": "Dark paper" },
				{ "slug": "dark-canvas", "color": "#1a1919", "name": "Dark canvas" },
				{ "slug": "dark-ink", "color": "#ffffff", "name": "Dark ink" },
				{ "slug": "dark-copy", "color": "#d9d9d9", "name": "Dark copy" },
				{ "slug": "dark-muted", "color": "#979aa1", "name": "Dark muted" },
				{ "slug": "dark-line", "color": "#40464d", "name": "Dark line" },
				{ "slug": "dark-line-strong", "color": "#656a71", "name": "Dark line strong" },
				{ "slug": "dark-code", "color": "#111111", "name": "Dark code" }
			]
		},
		"typography": {
			"fontSizes": [
				{ "name": "Small", "size": "0.8125rem", "slug": "small" },
				{ "name": "Body", "size": "1rem", "slug": "body" },
				{ "name": "Lead", "size": "1.1875rem", "slug": "lead", "fluid": { "min": "1.0625rem", "max": "1.25rem" } },
				{ "name": "Heading 4", "size": "1.375rem", "slug": "heading-4", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "name": "Heading 3", "size": "1.875rem", "slug": "heading-3", "fluid": { "min": "1.625rem", "max": "2.125rem" } },
				{ "name": "Heading 2", "size": "2.75rem", "slug": "heading-2", "fluid": { "min": "2.125rem", "max": "3.25rem" } },
				{ "name": "Display", "size": "5rem", "slug": "display", "fluid": { "min": "2.875rem", "max": "5.75rem" } }
			]
		},
		"custom": {
			"radius": "2px",
			"fontUi": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
			"fontCopy": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
			"fontHeading": "\"EB Garamond\", \"Iowan Old Style\", Palatino, serif",
			"contentFontSize": "17px",
			"headingWeight": "700",
			"entryKickerGap": "7px",
			"entryKickerPadding": "0",
			"entryKickerBorder": "0",
			"entryKickerRadius": "0",
			"entryKickerBackground": "transparent",
			"entryKickerShadow": "none",
			"entryKickerColor": "var(--dp-blue-dark)",
			"entryKickerDarkBorder": "0",
			"entryKickerDarkBackground": "transparent",
			"entryKickerDarkShadow": "none",
			"entryKickerDarkColor": "var(--dp-blue-dark)",
			"entryKickerDarkMarkerBackground": "currentColor",
			"entryKickerLetterSpacing": "0.11em",
			"entryKickerMarkerWidth": "18px",
			"entryKickerMarkerHeight": "2px",
			"entryKickerMarkerRadius": "0",
			"entryKickerMarkerBackground": "currentColor",
			"entryTitleSize": "clamp(42px, 5.4vw, 64px)",
			"entryTitleWeight": "700",
			"entryTitleLetterSpacing": "-0.03em",
			"entryTitleLineHeight": "1",
			"entryRuleWidth": "54px",
			"entryRuleHeight": "2px",
			"entryRuleRadius": "0",
			"entryRuleBackground": "var(--dp-blue)"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|copy"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|50",
			"margin": {
				"bottom": "0",
				"left": "0",
				"right": "0",
				"top": "0"
			},
			"padding": {
				"bottom": "0",
				"left": "0",
				"right": "0",
				"top": "0"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "var(--wp--custom--content-font-size)",
			"fontStyle": "normal",
			"fontWeight": "400",
			"letterSpacing": "0",
			"lineHeight": "1.75",
			"textAlign": "left",
			"textColumns": "auto",
			"textDecoration": "none",
			"textIndent": "0",
			"textTransform": "none",
			"writingMode": "horizontal-tb"
		},
		"elements": {
			"button": {
				"border": {
					"color": "var:preset|color|accent",
					"radius": "var:custom|radius",
					"style": "solid",
					"width": "0"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|paper"
				},
				"spacing": {
					"padding": {
						"bottom": "0.72em",
						"left": "1.2em",
						"right": "1.2em",
						"top": "0.72em"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|body",
					"fontStyle": "normal",
					"fontWeight": "600",
					"letterSpacing": "0",
					"lineHeight": "1.2",
					"textAlign": "center",
					"textColumns": "auto",
					"textDecoration": "none",
					"textIndent": "0",
					"textTransform": "none",
					"writingMode": "horizontal-tb"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-strong",
						"text": "var:preset|color|paper"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"caption": {
				"color": {
					"background": "transparent",
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "normal",
					"fontWeight": "700",
					"letterSpacing": "0.01em",
					"lineHeight": "1.5",
					"textAlign": "left",
					"textColumns": "auto",
					"textDecoration": "none",
					"textIndent": "0",
					"textTransform": "none",
					"writingMode": "horizontal-tb"
				}
			},
			"heading": {
				"color": {
					"background": "transparent",
					"text": "var:preset|color|ink"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|eb-garamond",
					"fontStyle": "normal",
					"fontWeight": "700",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.12",
					"textAlign": "left",
					"textColumns": "auto",
					"textDecoration": "none",
					"textIndent": "0",
					"textTransform": "none",
					"writingMode": "horizontal-tb"
				}
			},
			"h1": {
				"color": {
					"background": null,
					"text": null
				},
				"typography": {
					"fontFamily": null,
					"fontSize": "var:preset|font-size|heading-2",
					"fontStyle": null,
					"fontWeight": null,
					"letterSpacing": "-0.03em",
					"lineHeight": "1",
					"textAlign": null,
					"textColumns": null,
					"textDecoration": null,
					"textIndent": null,
					"textTransform": null,
					"writingMode": null
				}
			},
			"h2": {
				"color": {
					"background": null,
					"text": null
				},
				"typography": {
					"fontFamily": null,
					"fontSize": "var:preset|font-size|heading-3",
					"fontStyle": null,
					"fontWeight": null,
					"letterSpacing": "-0.025em",
					"lineHeight": "1.08",
					"textAlign": null,
					"textColumns": null,
					"textDecoration": null,
					"textIndent": null,
					"textTransform": null,
					"writingMode": null
				}
			},
			"h3": {
				"color": {
					"background": null,
					"text": null
				},
				"typography": {
					"fontFamily": null,
					"fontSize": "var:preset|font-size|heading-4",
					"fontStyle": null,
					"fontWeight": null,
					"letterSpacing": "-0.02em",
					"lineHeight": "1.15",
					"textAlign": null,
					"textColumns": null,
					"textDecoration": null,
					"textIndent": null,
					"textTransform": null,
					"writingMode": null
				}
			},
			"h4": {
				"color": {
					"background": null,
					"text": null
				},
				"typography": {
					"fontFamily": null,
					"fontSize": "var:preset|font-size|lead",
					"fontStyle": null,
					"fontWeight": null,
					"letterSpacing": "-0.012em",
					"lineHeight": "1.22",
					"textAlign": null,
					"textColumns": null,
					"textDecoration": null,
					"textIndent": null,
					"textTransform": null,
					"writingMode": null
				}
			},
			"h5": {
				"color": {
					"background": null,
					"text": null
				},
				"typography": {
					"fontFamily": null,
					"fontSize": "var:preset|font-size|body",
					"fontStyle": null,
					"fontWeight": null,
					"letterSpacing": "-0.006em",
					"lineHeight": "1.3",
					"textAlign": null,
					"textColumns": null,
					"textDecoration": null,
					"textIndent": null,
					"textTransform": null,
					"writingMode": null
				}
			},
			"h6": {
				"color": {
					"background": null,
					"text": null
				},
				"typography": {
					"fontFamily": null,
					"fontSize": "var:preset|font-size|small",
					"fontStyle": null,
					"fontWeight": null,
					"letterSpacing": "0.04em",
					"lineHeight": "1.4",
					"textAlign": null,
					"textColumns": null,
					"textDecoration": null,
					"textIndent": null,
					"textTransform": null,
					"writingMode": null
				}
			},
			"link": {
				"color": {
					"background": "transparent",
					"text": "var:preset|color|accent-strong"
				},
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "inherit",
					"fontStyle": "inherit",
					"fontWeight": "inherit",
					"letterSpacing": "inherit",
					"lineHeight": "inherit",
					"textAlign": "inherit",
					"textColumns": "inherit",
					"textDecoration": "underline",
					"textIndent": "inherit",
					"textTransform": "inherit",
					"writingMode": "inherit"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var:preset|color|accent",
							"radius": "var:custom|radius",
							"style": "solid",
							"width": "1px"
						},
						"color": {
							"background": "transparent",
							"text": "var:preset|color|accent-strong"
						}
					}
				}
			},
			"core/code": {
				"border": {
					"color": "var:preset|color|line-strong",
					"radius": "var:custom|radius",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|code",
					"text": "var:preset|color|dark-ink"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|50",
						"right": "var:preset|spacing|50",
						"top": "var:preset|spacing|50"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "0.875rem",
					"fontStyle": "normal",
					"fontWeight": "400",
					"letterSpacing": "0",
					"lineHeight": "1.6",
					"textAlign": "left",
					"textColumns": "auto",
					"textDecoration": "none",
					"textIndent": "0",
					"textTransform": "none",
					"writingMode": "horizontal-tb"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|50"
					}
				}
			},
			"docspress/version-switcher": {
				"border": {
					"color": "var:preset|color|line-strong",
					"radius": "0",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "0.875rem",
					"fontWeight": "600"
				}
			},
			"docspress/version-notice": {
				"border": {
					"color": "var:preset|color|accent",
					"radius": "0",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|paper",
					"text": "var:preset|color|ink"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|50",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				}
			}
		}
	}
}
