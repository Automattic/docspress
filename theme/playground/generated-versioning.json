    {
      "key": "docs/v3/hello",
      "parentKey": "docs/v3",
      "slug": "hello",
      "title": "Hello from v3",
      "content": "<!-- docspress:{\"version\":1,\"key\":\"docs/v3/hello\",\"source\":\"examples/versioning/docs/hello.md\",\"hash\":\"6a42c660a4ac5c52fdaf5e1ccb197bd6a9f068dfae070bbdafc2873982b906fc\",\"docsVersion\":\"v3\",\"logicalRoute\":\"hello\",\"identity\":\"v3:hello\",\"sourceType\":\"root\",\"latest\":true,\"sourceContentBase64\":\"LS0tCnRpdGxlOiBIZWxsbyBmcm9tIHYzCnNpZGViYXJfcG9zaXRpb246IDEKLS0tCgpUaGlzIGlzIHRoZSBjdXJyZW50IEFQSSBkb2N1bWVudGF0aW9uLiBWZXJzaW9uIDMgdXNlcyBPQXV0aCBmb3IgYXV0aGVudGljYXRlZCByZXF1ZXN0cy4KClJlYWQgW0F1dGhlbnRpY2F0ZSB3aXRoIE9BdXRoXShhdXRoZW50aWNhdGlvbi9vYXV0aC5tZCkuCg==\",\"sidebarPosition\":1} -->\n<!-- wp:paragraph -->\n<p>This is the current API documentation. Version 3 uses OAuth for authenticated requests.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Read <a href=\"/docs/v3/authentication/oauth/\">Authenticate with OAuth</a>.</p>\n<!-- /wp:paragraph -->",
