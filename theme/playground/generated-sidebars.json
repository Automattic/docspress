      "slug": "rest-api",
      "title": "REST API",
      "content": "<!-- docspress:{\"version\":1,\"key\":\"docs/apis/rest-api\",\"source\":\"examples/contextual-sidebars/docs/apis/rest-api.md\",\"hash\":\"a4472ff12d2090eac97f942e07788cc6200d54c35a2e23a602cca15742660236\",\"sourceContentBase64\":\"\",\"sidebarPosition\":10,\"sidebarId\":\"api\",\"sidebarRoot\":false} -->\n<!-- wp:paragraph -->\n<p>Send JSON requests to the Acme REST API:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:code -->\n<pre class=\"wp-block-code\"><code class=\"language-http\">GET /v1/widgets\nAuthorization: Bearer &lt;access-token&gt;</code></pre>\n<!-- /wp:code -->\n\n<!-- wp:paragraph -->\n<p>API previous/next links stay inside this focused navigation context.</p>\n<!-- /wp:paragraph -->",
      "sourcePath": "examples/contextual-sidebars/docs/apis/rest-api.md",
      "depth": 3,
      "menuOrder": 10,
      "sidebarId": "api",
      "sidebarRoot": false
    },
    {
