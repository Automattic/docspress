{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "DocsPress",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [
				{
					"colors": [ "#005cb3", "#fec408" ],
					"name": "DocsPress blue and Wapuu yellow",
					"slug": "docspress"
				},
				{
					"colors": [ "#1e1e1e", "#3858e9" ],
					"name": "WordPress ink and blueberry",
					"slug": "wordpress"
				},
				{
					"colors": [ "#101517", "#0ced57" ],
					"name": "Jetpack ink and electric green",
					"slug": "jetpack"
				}
			],
			"gradients": [
				{
					"gradient": "linear-gradient(135deg, #005cb3 0%, #3858e9 55%, #fec408 100%)",
					"name": "DocsPress signal",
					"slug": "docspress-signal"
				},
				{
					"gradient": "linear-gradient(135deg, #3858e9 0%, #5300be 100%)",
					"name": "WordPress blueberry to purple",
					"slug": "wordpress-spectrum"
				},
				{
					"gradient": "linear-gradient(135deg, #0ced57 0%, #069e08 100%)",
					"name": "Jetpack electric",
					"slug": "jetpack-electric"
				}
			],
			"palette": [
				{ "slug": "accent", "color": "#005cb3", "name": "Accent" },
				{ "slug": "accent-strong", "color": "#004a91", "name": "Accent strong" },
				{ "slug": "accent-soft", "color": "#e9f4ff", "name": "Accent soft" },
				{ "slug": "highlight", "color": "#fec408", "name": "Highlight" },
				{ "slug": "highlight-strong", "color": "#fe8301", "name": "Highlight strong" },
				{ "slug": "paper", "color": "#ffffff", "name": "Paper" },
				{ "slug": "canvas", "color": "#f5faff", "name": "Canvas" },
				{ "slug": "ink", "color": "#232323", "name": "Ink" },
				{ "slug": "copy", "color": "#3d4348", "name": "Copy" },
				{ "slug": "muted", "color": "#6e7479", "name": "Muted" },
				{ "slug": "line", "color": "#d8e5ee", "name": "Line" },
				{ "slug": "line-strong", "color": "#a9c1d2", "name": "Line strong" },
				{ "slug": "code", "color": "#151923", "name": "Code" },
				{ "slug": "dark-accent", "color": "#62b5ff", "name": "Dark accent" },
				{ "slug": "dark-accent-strong", "color": "#93ccff", "name": "Dark accent strong" },
				{ "slug": "dark-accent-soft", "color": "#123b5d", "name": "Dark accent soft" },
				{ "slug": "dark-paper", "color": "#15191d", "name": "Dark paper" },
				{ "slug": "dark-canvas", "color": "#0c1217", "name": "Dark canvas" },
				{ "slug": "dark-ink", "color": "#fefefe", "name": "Dark ink" },
				{ "slug": "dark-copy", "color": "#dce6ed", "name": "Dark copy" },
				{ "slug": "dark-muted", "color": "#a7b4bd", "name": "Dark muted" },
				{ "slug": "dark-line", "color": "#293842", "name": "Dark line" },
				{ "slug": "dark-line-strong", "color": "#455966", "name": "Dark line strong" },
				{ "slug": "dark-code", "color": "#090d11", "name": "Dark code" }
			]
		},
		"custom": {
			"radius": "14px",
			"fontUi": "\"Nunito Sans\", \"Trebuchet MS\", sans-serif",
			"fontCopy": "\"Nunito Sans\", \"Trebuchet MS\", sans-serif",
			"fontHeading": "\"Nunito Sans\", \"Trebuchet MS\", sans-serif",
			"headerHeight": "68px",
			"sidebarWidth": "266px",
			"tocWidth": "226px",
			"contentWidth": "770px",
			"contentFontSize": "17px",
			"headingWeight": "900",
			"entryKickerGap": "6px",
			"entryKickerPadding": "4px 10px 4px 8px",
			"entryKickerBorder": "2px solid var(--dp-ink)",
			"entryKickerRadius": "999px",
			"entryKickerBackground": "var(--dp-highlight)",
			"entryKickerShadow": "3px 3px 0 var(--dp-highlight-strong)",
			"entryKickerColor": "var(--dp-ink)",
			"entryKickerLetterSpacing": "0.08em",
			"entryKickerMarkerWidth": "6px",
			"entryKickerMarkerHeight": "6px",
			"entryKickerMarkerRadius": "50%",
			"entryKickerMarkerBackground": "var(--dp-highlight-strong)",
			"entryTitleSize": "clamp(42px, 5.6vw, 68px)",
			"entryTitleWeight": "var(--dp-heading-weight)",
			"entryTitleLetterSpacing": "-0.06em",
			"entryTitleLineHeight": "0.98",
			"entryRuleWidth": "74px",
			"entryRuleHeight": "4px",
			"entryRuleRadius": "999px",
			"entryRuleBackground": "linear-gradient(90deg, var(--dp-blue) 0 72%, var(--dp-highlight) 72% 100%)",
			"searchWidth": "680px",
			"searchHeight": "640px",
			"searchRadius": "14px",
			"searchOverlayOpacity": "44%",
			"searchOverlayBlur": "2px"
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"layout": {
			"contentSize": "770px",
			"wideSize": "1100px"
		},
		"lightbox": {
			"enabled": true
		},
		"position": {
			"sticky": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft",
					"shadow": "0 16px 48px rgba(23, 26, 34, 0.08)",
					"slug": "soft"
				},
				{
					"name": "Lifted",
					"shadow": "0 24px 72px rgba(23, 26, 34, 0.16)",
					"slug": "lifted"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"margin": true,
			"padding": true,
			"spacingSizes": [
				{ "name": "2XS", "size": "0.25rem", "slug": "10" },
				{ "name": "XS", "size": "0.5rem", "slug": "20" },
				{ "name": "S", "size": "0.75rem", "slug": "30" },
				{ "name": "M", "size": "1rem", "slug": "40" },
				{ "name": "L", "size": "1.5rem", "slug": "50" },
				{ "name": "XL", "size": "2rem", "slug": "60" },
				{ "name": "2XL", "size": "3rem", "slug": "70" },
				{ "name": "3XL", "size": "4.5rem", "slug": "80" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": true,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "ui",
					"name": "DocsPress UI",
					"fontFamily": "\"Nunito Sans\", \"Trebuchet MS\", sans-serif"
				},
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"slug": "eb-garamond",
					"name": "EB Garamond",
					"fontFamily": "\"EB Garamond\", \"Iowan Old Style\", Palatino, serif"
				},
				{
					"slug": "recoleta",
					"name": "Recoleta",
					"fontFamily": "Recoleta, \"EB Garamond\", Georgia, serif"
				},
				{
					"slug": "reading",
					"name": "Reading serif",
					"fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Georgia, serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "name": "Small", "size": "0.8125rem", "slug": "small" },
				{ "name": "Body", "size": "1rem", "slug": "body" },
				{ "name": "Lead", "size": "1.1875rem", "slug": "lead", "fluid": { "min": "1.0625rem", "max": "1.25rem" } },
				{ "name": "Heading 4", "size": "1.375rem", "slug": "heading-4", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "name": "Heading 3", "size": "1.75rem", "slug": "heading-3", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "name": "Heading 2", "size": "2.5rem", "slug": "heading-2", "fluid": { "min": "2rem", "max": "3rem" } },
				{ "name": "Display", "size": "4.75rem", "slug": "display", "fluid": { "min": "2.75rem", "max": "5.5rem" } }
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textColumns": true,
			"textDecoration": true,
			"textIndent": "all",
			"textTransform": true,
			"writingMode": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--dp-paper)",
			"text": "var(--dp-copy)"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|50",
			"padding": {
				"left": "0",
				"right": "0"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|ui",
			"fontSize": "var:custom|contentFontSize",
			"lineHeight": "1.78"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "var:custom|radius"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|paper"
				},
				"spacing": {
					"padding": {
						"bottom": "0.7em",
						"left": "1.15em",
						"right": "1.15em",
						"top": "0.7em"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|ui",
					"fontWeight": "700"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-strong",
						"text": "var:preset|color|paper"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--dp-muted)"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"heading": {
				"color": {
					"text": "var(--dp-ink)"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|ui",
					"fontWeight": "var:custom|headingWeight",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.12"
				}
			},
			"link": {
				"color": {
					"text": "var(--dp-blue-dark)"
				},
				":hover": {
					"color": {
						"text": "var(--dp-blue)"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var:preset|color|accent",
							"radius": "var:custom|radius",
							"style": "solid",
							"width": "1px"
						},
						"color": {
							"background": "transparent",
							"text": "var:preset|color|accent-strong"
						}
					}
				}
			},
			"core/code": {
				"border": {
					"radius": "var:custom|radius"
				},
				"color": {
					"background": "var:preset|color|code",
					"text": "#eff2f8"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|50",
						"right": "var:preset|spacing|50",
						"top": "var:preset|spacing|50"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "0.875rem"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|ui",
					"fontSize": "0.9375rem",
					"fontWeight": "700"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|50"
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|ui",
					"fontSize": "1.0625rem",
					"fontWeight": "900"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-no-sidebar",
			"postTypes": [ "page" ],
			"title": "Page without documentation sidebar"
		},
		{
			"name": "page-wide",
			"postTypes": [ "page", "post" ],
			"title": "Wide content"
		}
	],
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Header" },
		{ "area": "footer", "name": "footer", "title": "Footer" },
		{ "area": "comments", "name": "comments", "title": "Comments" }
	]
}
