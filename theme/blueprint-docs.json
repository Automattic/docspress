{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "DocsPress Documentation",
		"author": "Automattic",
		"description": "The complete DocsPress documentation, converted from Markdown into a temporary editable WordPress site."
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"constants": {
		"WP_ENVIRONMENT_TYPE": "development"
	},
	"landingPage": "/docs/",
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/Automattic/docspress",
				"ref": "main",
				"refType": "branch",
				"path": "plugins/docspress-blocks"
			},
			"options": {
				"activate": true,
				"targetFolderName": "docspress-blocks"
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/Automattic/docspress",
				"ref": "main",
				"refType": "branch",
				"path": "theme"
			},
			"options": {
				"activate": true,
				"targetFolderName": "docspress"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require get_theme_root( 'docspress' ) . '/docspress/playground/setup.php';"
		}
	]
}
