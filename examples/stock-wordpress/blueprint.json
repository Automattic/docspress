{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Autodocs Publish on stock WordPress",
    "author": "Automattic",
    "description": "Markdown published as native Gutenberg Pages with no Autodocs Publish theme or Blocks plugin installed."
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "constants": {
    "WP_ENVIRONMENT_TYPE": "development"
  },
  "landingPage": "/",
  "login": true,
  "steps": [
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once '/wordpress/wp-load.php';\n\n$generated = json_decode( base64_decode( '' ), true );\nif ( ! is_array( $generated ) || empty( $generated['pages'] ) ) {\n\twp_die( 'The stock WordPress documentation payload is invalid.' );\n}\n\nforeach ( array( array( 'post', 'hello-world' ), array( 'page', 'sample-page' ) ) as $starter_content ) {\n\t$starter_post = get_page_by_path( $starter_content[1], OBJECT, $starter_content[0] );\n\tif ( $starter_post ) {\n\t\twp_delete_post( $starter_post->ID, true );\n\t}\n}\n\nusort(\n\t$generated['pages'],\n\tstatic function ( $left, $right ) {\n\t\t$depth_comparison = (int) $left['depth'] <=> (int) $right['depth'];\n\t\treturn $depth_comparison ? $depth_comparison : strcmp( $left['key'], $right['key'] );\n\t}\n);\n\n$ids_by_key = array();\n$order_by_parent = array();\n\nforeach ( $generated['pages'] as $page ) {\n\t$parent_key = isset( $page['parentKey'] ) ? (string) $page['parentKey'] : '';\n\t$parent_id = $parent_key && isset( $ids_by_key[ $parent_key ] ) ? $ids_by_key[ $parent_key ] : 0;\n\tif ( $parent_key && ! $parent_id ) {\n\t\twp_die( esc_html( 'Generated documentation parent is unavailable: ' . $parent_key ) );\n\t}\n\n\t$content = (string) $page['content'];\n\tif ( 'docs' === $page['key'] ) {\n\t\trequire_once ABSPATH . 'wp-admin/includes/plugin.php';\n\t\t$active_theme = wp_get_theme();\n\t\t$theme_state = wp_get_theme( 'autodocs-publish' )->exists() ? 'Installed' : 'Not installed';\n\t\t$blocks_state = file_exists( WP_PLUGIN_DIR . '/autodocs-publish-blocks/autodocs-publish-blocks.php' ) ? 'Installed' : 'Not installed';\n\t\t$proof = '<figure class=\"wp-block-table\"><table><thead><tr><th>Runtime component</th><th>State</th></tr></thead><tbody>';\n\t\t$proof .= '<tr><td>Active theme</td><td>' . esc_html( $active_theme->get( 'Name' ) ) . '</td></tr>';\n\t\t$proof .= '<tr><td>Autodocs Publish theme</td><td>' . esc_html( $theme_state ) . '</td></tr>';\n\t\t$proof .= '<tr><td>Autodocs Publish Blocks plugin</td><td>' . esc_html( $blocks_state ) . '</td></tr>';\n\t\t$proof .= '<tr><td>Published content</td><td>Native core Gutenberg blocks</td></tr>';\n\t\t$proof .= '</tbody></table></figure>';\n\t\t$content .= \"\\n\\n\" . get_comment_delimited_block_content( 'core/heading', array( 'level' => 2 ), '<h2 class=\"wp-block-heading\">Runtime proof</h2>' );\n\t\t$content .= \"\\n\\n\" . get_comment_delimited_block_content( 'core/table', array(), $proof );\n\t}\n\n\t$order_key = $parent_key ? $parent_key : 'root';\n\t$order = isset( $order_by_parent[ $order_key ] ) ? $order_by_parent[ $order_key ] : 0;\n\t$existing = get_page_by_path( (string) $page['slug'], OBJECT, 'page' );\n\t$post_data = array(\n\t\t'ID' => $existing ? $existing->ID : 0,\n\t\t'post_type' => 'page',\n\t\t'post_status' => 'publish',\n\t\t'post_title' => (string) $page['title'],\n\t\t'post_name' => (string) $page['slug'],\n\t\t'post_parent' => $parent_id,\n\t\t'menu_order' => $order * 10,\n\t\t'post_content' => $content,\n\t);\n\t$page_id = wp_insert_post( wp_slash( $post_data ), true );\n\tif ( is_wp_error( $page_id ) ) {\n\t\twp_die( esc_html( $page_id->get_error_message() ) );\n\t}\n\n\t$ids_by_key[ $page['key'] ] = (int) $page_id;\n\t$order_by_parent[ $order_key ] = $order + 1;\n}\n\n$docs_id = isset( $ids_by_key['docs'] ) ? $ids_by_key['docs'] : 0;\nif ( ! $docs_id ) {\n\twp_die( 'The generated documentation does not contain the docs root Page.' );\n}\n\nupdate_option( 'blogname', 'Autodocs Publish on stock WordPress' );\nupdate_option( 'show_on_front', 'page' );\nupdate_option( 'page_on_front', $docs_id );\nupdate_option( 'permalink_structure', '/%postname%/' );\nflush_rewrite_rules();\n"
    }
  ]
}
